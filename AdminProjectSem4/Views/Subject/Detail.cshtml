@model API.Models.Subject

@{
    ViewData["Title"] = "Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Subject information</h1>
<div class="container">

    <div class="btn-danger text-center">@ViewBag.Error</div>
    <hr />
    <section class="content mt-4">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <form asp-action="Create" method="post">
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Subject Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter subject name..." disabled/>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxScore" class="form-label fw-bold">Max Score</label>
                                <input asp-for="MaxScore" type="number" class="form-control" placeholder="e.g. 100" disabled/>
                                <span asp-validation-for="MaxScore" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PassScore" class="form-label fw-bold">Pass Score</label>
                                <input asp-for="PassScore" type="number" class="form-control" placeholder="e.g. 50" disabled/>
                                <span asp-validation-for="PassScore" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Status" class="form-check-input" disabled/>
                            <label asp-for="Status" class="form-check-label">Active</label>
                        </div>

                        <div class="d-flex justify-content-end">
                            <a asp-action="Index" class="btn btn-primary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

</div>