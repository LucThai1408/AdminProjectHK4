
@model IEnumerable<API.Models.AccountExamDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentPage = ViewBag.CurrentPage;
    var totalPage = ViewBag.TotalPage;
    var name = ViewBag.Name as string;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<h1>List of student exams</h1>

<div class="container">
    <div class="d-flex justify-content-between align-items-center">
        @if (userRole == "1")
        {
            <p>
                <a asp-action="Create" class="btn btn-primary">Create New</a>
            </p>
        }
    </div>

    <!-- ✅ Thêm div bọc table -->
    <div class="table-responsive" style="overflow-x: auto; max-width: 100%;">
        <table class="table table-bordered table-hover text-nowrap">
            <thead>
                <tr>
                    <th class="col-1">Id</th>
                    <th class="col-2">Course Name</th>
                    <th class="col-2">Subject name</th>
                    <th class="col-2">Exam name</th>
                    <th class="col-2">Student name</th>
                    <th class="col-2">Score</th>
                    <th class="col-1">@Html.DisplayNameFor(model => model.IsPass)</th>
                    <th class="col-4">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AccountExamId</td>
                        <td>@item.Course</td>
                        <td>@item.Subject</td>
                        <td>@item.ExamName</td>
                        <td>Sem @item.StudentName</td>
                        <td>@item.Score</td>
                        <td>
                            @(item.IsPass ? "Pass" : "Failed")
                        </td>
                        <td>
                            <a asp-action="Detail" asp-route-id="@item.AccountExamId" class="btn btn-info me-1 text-white">
                                <i class="bi bi-info-circle"></i> Details
                            </a>
                            @if (userRole == "1")
                            {
                                <a asp-action="Edit" asp-route-id="@item.AccountExamId" class="btn btn-success me-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                @if (item.Status)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.AccountExamId" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@item.AccountExamId" />
                                        <button type="submit" class="btn btn-danger"
                                                onclick="return confirm('Do you sure wanna deactive this?')">
                                            Deactive
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled>
                                        Deactivated
                                    </button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- ✅ Kết thúc div scroll -->
