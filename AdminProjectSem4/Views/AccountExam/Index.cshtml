
@model IEnumerable<API.Models.AccountExam>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentPage = ViewBag.CurrentPage;
    var totalPage = ViewBag.TotalPage;
    var name = ViewBag.Name as string;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<h1>List of student exams</h1>

<div class="container">

    @* <div class="btn-success text-center text-uppercase">@TempData["msg"]</div> *@
    <div class="d-flex justify-content-between align-items-center">
        @if (userRole == "1")
        {
            <p>
                <a asp-action="Create" class="btn btn-primary">Create New</a>
        </p>
        }
    </div>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th class="col-1">
                    Id
                </th>
                <th class="col-2">
                    Subject name
                </th>
                <th class="col-2">
                    Exam name
                </th>
                <th class="col-2">
                    Student name
                </th>
                <th class="col-1">
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th class="col-4">
                    Action
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.AccountExamId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Subject.Name)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Exam.Name)
                    </td>
                    <td>
                        Sem @Html.DisplayFor(modelItem => item.Student.FullName)
                    </td>
                    @if (item.Status = true)
                    {
                        <td>Active</td>
                    }
                    else
                    {
                        <td>InActive</td>
                    }
                    <td>
                        <a asp-action="Detail" asp-route-id="@item.AccountExamId" class="btn btn-info me-1 text-white">
                            <i class="bi bi-info-circle"></i> Details
                        </a>
                        @if (userRole == "1")
                        {
                            <a asp-action="Edit" asp-route-id="@item.AccountExamId" class="btn btn-success me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            
                            @if (item.Status)
                            {
                                <form asp-action="Delete" asp-route-id="@item.AccountExamId" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.AccountExamId" />
                                    <button type="submit" class="btn btn-danger"
                                            onclick="return confirm('Do you sure wanna deactive this?')">
                                        Deactive
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary" disabled>
                                    Deactivated
                                </button>
                            }
                            
                        }
                    </td>

                </tr>
            }
        </tbody> 
     </table> 
    @if (Model.Count() != 0)
    {
        @if (name.Trim().Equals(""))
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <!-- Nút 'Trước' -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?currentPage=@(currentPage - 1)" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    <!-- Các số trang -->
                    @for (int i = 1; i <= totalPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?currentPage=@i">@i</a>
                        </li>
                    }

                    <!-- Nút 'Tiếp theo' -->
                    <li class="page-item @(currentPage == totalPage ? "disabled" : "")">
                        <a class="page-link" href="?currentPage=@(currentPage + 1)" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
        else
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <!-- Nút 'Trước' -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?currentPage=@(currentPage - 1)&name=@name" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    <!-- Các số trang -->
                    @for (int i = 1; i <= totalPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?currentPage=@i&name=@name">@i</a>
                        </li>
                    }

                    <!-- Nút 'Tiếp theo' -->
                    <li class="page-item @(currentPage == totalPage ? "disabled" : "")">
                        <a class="page-link" href="?currentPage=@(currentPage + 1)&name=@name" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <p class="text-center">No item!</p>
    }

</div>