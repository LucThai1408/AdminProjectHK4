@model API.Models.AccountExam

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content mt-4">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">


                <h3 class="text-center mb-4 fw-bold mt-4">Create a new account exam</h3>

                <!-- ✅ Hiển thị thông báo lỗi -->
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center fw-bold">
                        @Html.Raw(ViewBag.Error)
                    </div>
                }

                <form asp-action="Create" enctype="multipart/form-data" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- ✅ Dropdown Course + Subject -->
                    <div class="form-group mb-3">
                        <label asp-for="CourseSubjectId" class="form-label fw-bold">Course - Subject</label>
                        <select asp-for="CourseSubjectId" asp-items="@ViewBag.Subject" class="form-control">
                        </select>
                        <span asp-validation-for="CourseSubjectId" class="text-danger small"></span>
                    </div>

                    <!-- ✅ Dropdown Exam -->
                    <div class="form-group mb-3">
                        <label asp-for="ExamId" class="form-label fw-bold">Exam</label>
                        <select asp-for="ExamId" asp-items="@ViewBag.Exam" class="form-control">
                        </select>
                        <span asp-validation-for="ExamId" class="text-danger small"></span>
                    </div>

                    <!-- ✅ Dropdown Student -->
                    <div class="form-group mb-3">
                        <label asp-for="StudentId" class="form-label fw-bold">Student</label>
                        <select asp-for="StudentId" asp-items="@ViewBag.Student" class="form-control">
                        </select>
                        <span asp-validation-for="StudentId" class="text-danger small"></span>
                    </div>

                    <!-- ✅ Nhập điểm -->
                    <div class="form-group mb-3">
                        <label asp-for="Score" class="form-label fw-bold">Score</label>
                        <input asp-for="Score" type="number" class="form-control" placeholder="e.g. 10" min="0" max="10" />
                        <span asp-validation-for="Score" class="text-danger small"></span>
                    </div>

                    <!-- ✅ Trạng thái -->
                    <div class="form-group form-check mt-2">
                        <input class="form-check-input" checked asp-for="Status" />
                        <label class="form-check-label" asp-for="Status">Active</label>
                    </div>

                    <!-- ✅ Nút hành động -->
                    <div class="form-group mt-3 text-center">
                        <input type="submit" value="Create" class="btn btn-success me-2" />
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}