@model API.Models.AccountExam
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content mt-4">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h3 class="text-center mb-4 fw-bold mt-4">Create a new account exam</h3>

                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group">
                                <label asp-for="CourseSubjectId" class="control-label">Subject</label>
                                <select asp-for="CourseSubjectId" asp-items="@ViewBag.Subject" class="form-control"></select>
                                <span asp-validation-for="CourseSubjectId" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                 <label asp-for="ExamId" class="control-label">Course</label>
                                <select asp-for="ExamId" asp-items="@ViewBag.Exam" class="form-control"></select>
                                <span asp-validation-for="ExamId" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="StudentId" class="control-label">Student</label>
                                <select asp-for="StudentId" asp-items="@ViewBag.Student" class="form-control"></select>
                                <span asp-validation-for="StudentId" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Score" class="form-label fw-bold">Score</label>
                                <input asp-for="Score" type="number" class="form-control" placeholder="e.g. 10" min="1" max="10"/>
                                <span asp-validation-for="Score" class="text-danger small"></span>
                            </div>

                            <div class="form-group form-check p-0 mt-2">
                                <label class="mr-5">Status:</label>
                                <input class="form-check-input" asp-for="Status" checked /> Active
                            </div>

                    <!-- Nút hành động -->
                    <div class="form-group mt-3">
                        <input type="submit" value="Create" class="btn btn-success" />
                        <a asp-action="Index" class="btn btn-secondary ml-2">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</div>
