@model API.Models.AccountExam
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var accountId = User.Claims.Skip(1).FirstOrDefault().Value as string;
}

<section class="content mt-4">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h3 class="text-center mb-4 fw-bold mt-4">Update infomation</h3>

                <!-- ✅ Hiển thị thông báo lỗi -->
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center fw-bold">
                        @Html.Raw(ViewBag.Error)
                    </div>
                }

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- 🔹 ID -->
                    <input asp-for="AccountExamId" type="hidden" />

                    <!-- 🔹 Subject -->
                    <div class="form-group">
                        <label asp-for="CourseSubjectId" class="control-label">Subject</label>
                        <select asp-for="CourseSubjectId" asp-items="@ViewBag.Subject" class="form-control" disabled></select>
                        <input type="hidden" name="CourseSubjectId" value="@Model.CourseSubjectId" />
                        <span asp-validation-for="CourseSubjectId" class="text-danger"></span>
                    </div>

                    <!-- 🔹 Exam -->
                    <div class="form-group">
                        <label asp-for="ExamId" class="control-label">Exam</label>
                        <select asp-for="ExamId" asp-items="@ViewBag.Exam" class="form-control" disabled></select>

                        <input type="hidden" name="ExamId" value="@Model.ExamId" />
                        <span asp-validation-for="ExamId" class="text-danger"></span>
                    </div>

                    <!-- 🔹 Student -->
                    <div class="form-group">
                        <label asp-for="StudentId" class="control-label">Student</label>
                        <select asp-for="StudentId" asp-items="@ViewBag.Student" class="form-control" disabled></select>

                        <input type="hidden" name="StudentId" value="@Model.StudentId" />
                        <span asp-validation-for="StudentId" class="text-danger"></span>
                    </div>

                    <!-- 🔹 Score -->
                    <div class="form-group">
                        <label asp-for="Score" class="form-label fw-bold">Score</label>
                        <input asp-for="Score" type="number" class="form-control" placeholder="e.g. 10" min="1" />
                        <span asp-validation-for="Score" class="text-danger small"></span>
                    </div>
                    <!-- 🔹 record -->
                    <div class="form-group">
                        <label asp-for="Record" class="form-label fw-bold">Score</label>
                        <input asp-for="Record" readonly type="number" class="form-control" />
                        <span asp-validation-for="Record" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Status" class="form-check-input" />
                        <label asp-for="Status" class="form-check-label">Active</label>
                    </div>
                    <!-- 🔹 Action buttons -->
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-success me-2 mr-3">Save</button>
                        <a asp-action="Index" class="btn btn-primary">Back to List</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

