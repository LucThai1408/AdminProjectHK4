@model IEnumerable<API.Models.RegisterDto>

@{
    ViewData["Title"] = "List of Exam Registers";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentPage = ViewBag.CurrentPage;
    var totalPage = ViewBag.TotalPage;
    var name = ViewBag.Name as string;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<h1>List of Register</h1>

<div class="container">

    <!-- ✅ Table hiển thị dữ liệu -->
    <div class="table-responsive" style="overflow-x: auto; max-width: 100%;">
        <table class="table table-bordered table-hover align-middle text-nowrap">
            <thead>
                <tr>
                    <th>Register ID</th>
                    <th>Student Name</th>
                    <th>Subject</th>
                    <th>Exam</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.RegisterId</td>
                            <td>@item.StudentName</td>
                            <td>@item.SubjectId</td>
                            <td>@item.ExamName</td>
                            <td>
                                @if (item.Status)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <div>
                                    <a asp-action="Details" asp-route-id="@item.RegisterId"
                                       class="btn btn-info btn-sm text-white">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center text-muted">No register found!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ✅ Pagination -->
    @if (Model != null && Model.Any())
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?currentPage=@(currentPage - 1)@(string.IsNullOrWhiteSpace(name) ? "" : $"&name={name}")">
                        &laquo;
                    </a>
                </li>

                @for (int i = 1; i <= totalPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="?currentPage=@i@(string.IsNullOrWhiteSpace(name) ? "" : $"&name={name}")">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPage ? "disabled" : "")">
                    <a class="page-link" href="?currentPage=@(currentPage + 1)@(string.IsNullOrWhiteSpace(name) ? "" : $"&name={name}")">
                        &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
