 @model API.Models.Room

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content mt-4">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h3 class="text-center mb-4 fw-bold mt-4">Update a room</h3>

                <form asp-action="Edit" method="post">
                    <input asp-for="RoomId" class="form-control" type="hidden" />
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Classroom Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter classroom name..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Status" class="form-check-input" />
                        <label asp-for="Status" class="form-check-label">Active</label>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-success me-2 mr-3">Save</button>
                        <a asp-action="Index" class="btn btn-primary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
