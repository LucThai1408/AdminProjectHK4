
@model IEnumerable<API.Models.Room>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentPage = ViewBag.CurrentPage;
    var totalPage = ViewBag.TotalPage;
    var name = ViewBag.Name as string;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<h1>List of classrooms</h1>

<div class="container">

    <div class="btn-success text-center text-uppercase">@TempData["msg"]</div>
    <div class="d-flex justify-content-between align-items-center">
        @if (userRole == "1")
        {
        <p>
            <a asp-action="Create" class="btn btn-primary">Create New</a>
        </p>
        }
        @* <form method="get" asp-action="Index" class="form-inline mb-3">
            <input type="text" name="name" value="@ViewBag.Name" class="form-control mr-2" placeholder="Search by name..." />
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-secondary ml-2">Reset</a>
        </form> *@

    </div>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th class="col-2">
                    @Html.DisplayNameFor(model => model.RoomId)
                </th>
                <th class="col-3">
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th class="col-3">
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th class="col-4">
                    Action
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.RoomId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    @if (item.Status)
                    {
                        <td>Active</td>
                    }
                    else
                    {
                        <td>InActive</td>
                    }
                    <td>
                        @if (userRole == "1")
                        {
                            <a asp-action="Edit" asp-route-id="@item.AccountId" class="btn btn-success">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.AccountId" class="btn btn-info">Details</a>

                            @if (item.Status)
                            {
                                <!-- ✅ Khi đang hoạt động -->
                                <form asp-action="Deactive" asp-controller="Accounts" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.AccountId" />
                                    <button type="submit" class="btn btn-danger"
                                            onclick="return confirm('Do you sure wanna deactive this?')">
                                        Deactive
                                    </button>
                                </form>
                            }
                            else
                            {
                                <!-- ⚠️ Khi đã bị vô hiệu hóa -->
                                <button class="btn btn-secondary" disabled title="This account is already deactivated">
                                    Deactivated
                                </button>
                            }
                        }
                        else if (userRole == "2")
                        {
                            <a asp-action="Details" asp-route-id="@item.AccountId" class="btn btn-info">Details</a>
                        }
                    </td>

                </tr>
            }
        </tbody> 
     </table> 
    @if (Model.Count() != 0)
    {
        @if (name.Trim().Equals(""))
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <!-- Nút 'Trước' -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?currentPage=@(currentPage - 1)" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    <!-- Các số trang -->
                    @for (int i = 1; i <= totalPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?currentPage=@i">@i</a>
                        </li>
                    }

                    <!-- Nút 'Tiếp theo' -->
                    <li class="page-item @(currentPage == totalPage ? "disabled" : "")">
                        <a class="page-link" href="?currentPage=@(currentPage + 1)" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
        else
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <!-- Nút 'Trước' -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="?currentPage=@(currentPage - 1)&name=@name" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    <!-- Các số trang -->
                    @for (int i = 1; i <= totalPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="?currentPage=@i&name=@name">@i</a>
                        </li>
                    }

                    <!-- Nút 'Tiếp theo' -->
                    <li class="page-item @(currentPage == totalPage ? "disabled" : "")">
                        <a class="page-link" href="?currentPage=@(currentPage + 1)&name=@name" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <p class="text-center">No item!</p>
    }

</div>