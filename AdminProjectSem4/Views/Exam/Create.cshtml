@model API.Models.Exam

@{
    ViewData["Title"] = "Create Exam";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="fw-bold text-uppercase mb-4 text-center">Create a New Exam</h2>

    @* Thông báo lỗi chung *@
    @if (!string.IsNullOrEmpty(ViewBag.Error as string))
    {
        <div class="alert alert-danger text-center fw-bold">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">
            <!-- Cột trái -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter exam name..." />
                    <span asp-validation-for="Name" class="text-danger">@ViewBag.ErrorName</span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Room</label>
                    <select asp-for="RoomId" asp-items="@ViewBag.Room" class="form-select"></select>
                    <span asp-validation-for="RoomId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Lecturer</label>
                    <select asp-for="AccountId" asp-items="@ViewBag.Account" class="form-select"></select>
                    <span asp-validation-for="AccountId" class="text-danger"></span>
                </div>
            </div>

            <!-- Cột phải -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="ExamDay" class="form-label fw-semibold"></label>
                    <input asp-for="ExamDay" type="date" class="form-control" />
                    <span asp-validation-for="ExamDay" class="text-danger">@ViewBag.ExamDay</span>
                </div>

                <div class="mb-3">
                    <label asp-for="ExamTime" class="form-label fw-semibold"></label>
                    <input asp-for="ExamTime" type="time" class="form-control" />
                    <span asp-validation-for="ExamTime" class="text-danger">@ViewBag.ExamTime</span>
                </div>

                <div class="mb-3">
                    <label asp-for="Fee" class="form-label fw-semibold"></label>
                    <input asp-for="Fee" type="number" min="1" class="form-control" placeholder="Enter fee..." />
                    <span asp-validation-for="Fee" class="text-danger">@ViewBag.Fee</span>
                </div>

                <div class="form-check mt-4">
                    <input class="form-check-input" asp-for="Status" checked />
                    <label asp-for="Status" class="form-check-label fw-semibold">Active</label>
                </div>
            </div>
        </div>

        <!-- Nút hành động -->
        <div class="mt-4 text-center">
            <button type="submit" class="btn btn-primary px-4 me-2">
                <i class="bi bi-plus-circle"></i> Create
            </button>
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
