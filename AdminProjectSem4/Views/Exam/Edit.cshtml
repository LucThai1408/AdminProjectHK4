@model API.Models.Exam

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Update exam information</h1>
<div class="container">

    <div class="btn-danger text-center">@ViewBag.Error</div>
    <hr />
    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group d-none">
            <label asp-for="ExamId" class="control-label"></label>
            <input asp-for="ExamId" class="form-control" type="hidden" />
            <span class="form-control">@Model.ExamId</span>
            <span asp-validation-for="ExamId" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter exam name..."/>
                    <span asp-validation-for="Name" class="text-danger">@ViewBag.ErrorName</span>
                </div>
                <div class="form-group">
                    <label class="control-label">Room</label>
                    <select asp-for="RoomId" asp-items="@ViewBag.Room" class="form-control"></select>
                    <span asp-validation-for="RoomId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">Lecturer</label>
                    <select asp-for="AccountId" asp-items="@ViewBag.Account" class="form-control"></select>
                    <span asp-validation-for="AccountId" class="text-danger"></span>
                </div>
            </div>

            <!-- Cột phải -->
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="ExamDay" class="control-label"></label>
                    <input asp-for="ExamDay" type="date" class="form-control" />
                    <span asp-validation-for="ExamDay" class="text-danger">@ViewBag.ExamDay</span>
                </div>
                <div class="form-group">
                    <label asp-for="ExamTime" class="control-label"></label>
                    <input asp-for="ExamTime" type="time" class="form-control" />
                    <span asp-validation-for="ExamTime" class="text-danger">@ViewBag.ExamTime</span>
                </div>
                <div class="form-group">
                    <label asp-for="Fee" class="control-label"></label>
                    <input asp-for="Fee" type="number" min="1" class="form-control" placeholder="Enter fee.."/>
                    <span asp-validation-for="Fee" class="text-danger">@ViewBag.Fee</span>
                </div>
                <div class="form-group form-check p-0">
                    
                    <label class="mr-5">Status:</label>
                    <input class="form-check-input" asp-for="Status" /> Active
                </div> 
            </div>
        </div>

        <!-- Nút hành động -->
        <div class="form-group mt-3">
            <input type="submit" value="Save" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary ml-2">Back to List</a>
        </div>
    </form>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</div>
