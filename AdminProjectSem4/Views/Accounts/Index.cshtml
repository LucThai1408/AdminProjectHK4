@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<API.Models.Account>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentPage = ViewBag.CurrentPage;
    var totalPage = ViewBag.TotalPage;
    var name = ViewBag.Name as string;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<h1>Quản lý tài khoản</h1>
<div class="btn-success text-center text-uppercase">@TempData["msg"]</div>

@if (userRole == "1")
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>
}

<form method="get" class="row g-2 mb-3 align-items-end">
    <!-- Tìm kiếm theo tên -->
    <div class="col-md-3">
        <label class="form-label visually-hidden">Tên</label>
        <input type="text" name="name" class="form-control" placeholder="Tìm kiếm theo tên, email, fullname"
               value="@ViewBag.Name" />
    </div>

    <!-- Dropdown Role -->
    <div class="col-md-3">
        <label class="form-label visually-hidden">Role</label>
        <select name="role" asp-items="@(ViewBag.RoleList as SelectList)" class="form-select"></select>
    </div>

    <!-- Dropdown Status -->
    <div class="col-md-3">
        <label class="form-label visually-hidden">Status</label>
        <select name="status" asp-items="@(ViewBag.StatusList as SelectList)" class="form-select"></select>
    </div>

    <!-- Nút lọc -->
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Lọc</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>AccountId</th>
            <th>UserName</th>
            <th>FullName</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.AccountId)</td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>

                @if (item.Role == 0)
                {
                    <td>Sinh viên</td>
                }
                else if (item.Role == 1)
                {
                    <td>Admin</td>
                }
                else if (item.Role == 2)
                {
                    <td>Giảng viên</td>
                }
                else
                {
                    <td>Không xác định</td>
                }

                <td>@(item.Status ? "Hoạt động" : "Không hoạt động")</td>

                <td>
                    @if (userRole == "1")
                    {
                        <a asp-action="Edit" asp-route-id="@item.AccountId" class="btn btn-success">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.AccountId" class="btn btn-info">Details</a>

                        @if (item.Status)
                        {
                            <!-- ✅ Khi đang hoạt động -->
                            <form asp-action="Deactive" asp-controller="Accounts" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.AccountId" />
                                <button type="submit" class="btn btn-danger"
                                        onclick="return confirm('Do you sure wanna deactive this?')">
                                    Deactive
                                </button>
                            </form>
                        }
                        else
                        {
                            <!-- ⚠️ Khi đã bị vô hiệu hóa -->
                            <button class="btn btn-secondary" disabled title="This account is already deactivated">
                                Deactivated
                            </button>
                        }
                    }
                    else if (userRole == "2")
                    {
                        <a asp-action="Details" asp-route-id="@item.AccountId" class="btn btn-info">Details</a>
                    }
                </td>

            </tr>
        }
    </tbody>
</table>

@if (Model.Count() != 0)
{
    @if (string.IsNullOrWhiteSpace(name))
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?currentPage=@(currentPage - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                @for (int i = 1; i <= totalPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="?currentPage=@i">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPage ? "disabled" : "")">
                    <a class="page-link" href="?currentPage=@(currentPage + 1)" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
    else
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?currentPage=@(currentPage - 1)&name=@name" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                @for (int i = 1; i <= totalPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="?currentPage=@i&name=@name">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPage ? "disabled" : "")">
                    <a class="page-link" href="?currentPage=@(currentPage + 1)&name=@name" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <p class="text-center">No item!</p>
}
