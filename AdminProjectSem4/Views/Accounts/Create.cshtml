@model API.Models.Account

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-center fw-bold my-4">Create Account</h1>
<hr />

<section class="content mt-4">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <!-- Cột trái -->
                        <div class="col-md-6">
                            <!-- Name -->
                            <div class="form-group mb-3">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorName</span>
                            </div>

                            <!-- FullName -->
                            <div class="form-group mb-3">
                                <label asp-for="FullName" class="control-label"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorFullName</span>
                            </div>

                            <!-- Password -->
                            <div class="form-group mb-3">
                                <label asp-for="Password" class="control-label"></label>
                                <input asp-for="Password" class="form-control" type="password" />
                                <span class="text-danger">@ViewBag.ErrorPassword</span>
                            </div>

                            <!-- Confirm Password -->
                            <div class="form-group mb-3">
                                <label class="control-label">Confirm Password</label>
                                <input type="password" name="confirmPassword" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorConfirmPassword</span>
                            </div>

                            <!-- Email -->
                            <div class="form-group mb-3">
                                <label asp-for="Email" class="control-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorEmail</span>
                            </div>

                            <!-- Phone -->
                            <div class="form-group mb-3">
                                <label asp-for="Phone" class="control-label"></label>
                                <input asp-for="Phone" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorPhone</span>
                            </div>
                        </div>

                        <!-- Cột phải -->
                        <div class="col-md-6">
                            <!-- DateOfBirth -->
                            <div class="form-group mb-3">
                                <label asp-for="DateOfBirth" class="control-label"></label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                                <span class="text-danger">@ViewBag.ErrorDateOfBirth</span>
                            </div>

                            <!-- Address -->
                            <div class="form-group mb-3">
                                <label asp-for="Address" class="control-label"></label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <!-- Role -->
                            <div class="form-group mb-3">
                                <label asp-for="Role" class="control-label"></label>
                                <select asp-for="Role" class="form-control">
                                    <option value="0">Sinh viên</option>
                                    <option value="1">Admin</option>
                                    <option value="2">Giảng viên</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger"></span>
                            </div>

                            <!-- Room -->
                            <div class="form-group mb-3">
                                <label asp-for="RoomId" class="control-label"></label>
                                <select asp-for="RoomId" asp-items="ViewBag.RoomList" class="form-control">
                                    <option value="">-- Chọn lớp học --</option>
                                </select>
                                <span asp-validation-for="RoomId" class="text-danger"></span>
                            </div>

                            <!-- Status -->
                            <div class="form-group mb-3">
                                <label asp-for="Status" class="control-label"></label>
                                <select asp-for="Status" class="form-control">
                                    <option value="true">Hoạt động</option>
                                    <option value="false">Không hoạt động</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>

                            <!-- Image -->
                            <div class="form-group mb-3">
                                <label asp-for="Image" class="control-label"></label>
                                <input name="fileImage" class="form-control" type="file" />
                                <span asp-validation-for="Image" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-success mr-2 mb-5">Create</button>
                        <a asp-action="Index" class="btn btn-primary mb-5">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
